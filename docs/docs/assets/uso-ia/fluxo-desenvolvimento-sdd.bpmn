      <bpmn:endEvent id="EndEvent_1" name="PR">
        <bpmn:incoming>Flow_6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:startEvent id="StartEvent_2" name="Nasceu um bug ou&#10;tarefa não planejada">
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_Avaliar" name="Avaliar complexidade&#10;e urgência">
