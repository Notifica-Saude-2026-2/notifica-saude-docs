  <bpmn:process id="Process_SDD" name="Fluxo SDD de desenvolvimento" isExecutable="false">
    <bpmn:task id="Activity_185pq2k" name="Cerimônia de Planning">
      <bpmn:incoming>Flow_18b1dop</bpmn:incoming>
