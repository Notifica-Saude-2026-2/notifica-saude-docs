<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Relatorios" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.0">
<bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_1" name="Elaboração do relatório de testes end-to-end – Sistema Notifica Saúde" processRef="Process_1"/><bpmn:group id="Group_1" categoryValueRef="CatVal_1"/><bpmn:group id="Group_2" categoryValueRef="CatVal_2"/><bpmn:group id="Group_3" categoryValueRef="CatVal_3"/><bpmn:group id="Group_4" categoryValueRef="CatVal_4"/></bpmn:collaboration>
<bpmn:process id="Process_1" name="Elaboração do relatório de testes" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_Tester" name="Tester (Qualidade e Testes)"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>R1</bpmn:flowNodeRef><bpmn:flowNodeRef>R4</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>R6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_IA" name="IA (Claude Code)"><bpmn:flowNodeRef>R2</bpmn:flowNodeRef><bpmn:flowNodeRef>R3</bpmn:flowNodeRef><bpmn:flowNodeRef>R5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Equipe" name="Equipe do projeto"><bpmn:flowNodeRef>R7</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start" name="Merge da automação da história realizado"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="R1" name="Solicitar a elaboração do relatório de testes end-to-end"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
<bpmn:task id="R2" name="Conferir execução, CI (três navegadores), contraprova e mapa CA × teste"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
<bpmn:task id="R3" name="Estruturar a página no MkDocs (modelo anterior) e gerar o PDF"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task>
<bpmn:task id="R4" name="Revisar o relatório"><bpmn:incoming>F4</bpmn:incoming><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G1" name="Há ajustes a fazer?"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="R5" name="Corrigir os pontos apontados"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
<bpmn:task id="R6" name="Enviar o relatório ao repositório pelo fluxo de GCS"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
<bpmn:task id="R7" name="Revisar o PR do relatório (colega)"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="End" name="Relatório publicado no MkDocs"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="R1"/>
<bpmn:sequenceFlow id="F2" sourceRef="R1" targetRef="R2"/>
<bpmn:sequenceFlow id="F3" sourceRef="R2" targetRef="R3"/>
<bpmn:sequenceFlow id="F4" sourceRef="R3" targetRef="R4"/>
<bpmn:sequenceFlow id="F5" sourceRef="R4" targetRef="G1"/>
<bpmn:sequenceFlow id="F6" name="Sim" sourceRef="G1" targetRef="R5"/>
<bpmn:sequenceFlow id="F7" sourceRef="R5" targetRef="R4"/>
<bpmn:sequenceFlow id="F8" name="Não" sourceRef="G1" targetRef="R6"/>
<bpmn:sequenceFlow id="F9" sourceRef="R6" targetRef="R7"/>
<bpmn:sequenceFlow id="F10" sourceRef="R7" targetRef="End"/>
</bpmn:process>
<bpmn:category id="Category_Etapas"><bpmn:categoryValue id="CatVal_1" value="Conferência dos dados"/><bpmn:categoryValue id="CatVal_2" value="Formatação"/><bpmn:categoryValue id="CatVal_3" value="Revisão"/><bpmn:categoryValue id="CatVal_4" value="Envio"/></bpmn:category>
