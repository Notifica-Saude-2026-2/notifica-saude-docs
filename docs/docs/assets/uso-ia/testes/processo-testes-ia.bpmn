<bpmn:collaboration id="Collaboration_Testes"><bpmn:participant id="Participant_Testes" name="Processo de testes com apoio de IA – Sistema Notifica Saúde" processRef="Process_Testes"/></bpmn:collaboration>
<bpmn:process id="Process_Testes" name="Processo de testes com apoio de IA" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_Autora" name="Autora (Qualidade e Testes)"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>PG1</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>TX</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>LA_t</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>T15</bpmn:flowNodeRef><bpmn:flowNodeRef>T16</bpmn:flowNodeRef><bpmn:flowNodeRef>GW6</bpmn:flowNodeRef><bpmn:flowNodeRef>T19</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_IA" name="IA (Claude Code)"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>PG2</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>LA_c</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>GW2</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>GW3</bpmn:flowNodeRef><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>T12</bpmn:flowNodeRef><bpmn:flowNodeRef>GW4</bpmn:flowNodeRef><bpmn:flowNodeRef>LB_t</bpmn:flowNodeRef><bpmn:flowNodeRef>LB_c</bpmn:flowNodeRef><bpmn:flowNodeRef>T13</bpmn:flowNodeRef><bpmn:flowNodeRef>GW5</bpmn:flowNodeRef><bpmn:flowNodeRef>T14</bpmn:flowNodeRef><bpmn:flowNodeRef>T17</bpmn:flowNodeRef><bpmn:flowNodeRef>T18</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Equipe" name="Equipe do projeto"><bpmn:flowNodeRef>TD</bpmn:flowNodeRef><bpmn:flowNodeRef>T20</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start" name="História de usuário disponível para teste"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="T1" name="Solicitar a conferência dos CAs com o protótipo"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
<bpmn:task id="T2" name="Comparar os CAs com o protótipo e registrar as inconsistências"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
<bpmn:task id="T3" name="Encaminhar as dúvidas aos responsáveis pelos requisitos"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task>
<bpmn:parallelGateway id="PG1"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:task id="T4" name="Redigir os casos de teste (CTs)"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
<bpmn:task id="TX" name="Realizar o teste exploratório e reportar as inconsistências"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
<bpmn:task id="TD" name="Corrigir as inconsistências e os erros reportados"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
<bpmn:task id="T5" name="Revisar os CTs (cobertura, categoria, critério e rastreabilidade)"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
<bpmn:parallelGateway id="PG2"><bpmn:incoming>F9</bpmn:incoming><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:task id="T6" name="Implementar os testes em Playwright (um teste por CA)"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:task>
<bpmn:task id="T7" name="Ler e revisar o código dos testes"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
<bpmn:intermediateThrowEvent id="LA_t" name="Continua em A"><bpmn:incoming>F13</bpmn:incoming><bpmn:linkEventDefinition id="LinkDef_LA_t" name="A"/></bpmn:intermediateThrowEvent>
<bpmn:intermediateCatchEvent id="LA_c" name="A"><bpmn:outgoing>F14</bpmn:outgoing><bpmn:linkEventDefinition id="LinkDef_LA_c" name="A"/></bpmn:intermediateCatchEvent>
<bpmn:task id="T8" name="Executar os testes localmente (sistema completo em Docker)"><bpmn:incoming>F14</bpmn:incoming><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW2" name="Há falhas?"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T9" name="Identificar a causa de cada falha"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:task>
<bpmn:task id="T10" name="Definir o encaminhamento de cada falha"><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW3" name="Origem do defeito?"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing><bpmn:outgoing>F21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T11" name="Corrigir o teste"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing></bpmn:task>
<bpmn:task id="T12" name="Preparar a issue [BUG] e o registro no Relatório de Bugs"><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW4"><bpmn:incoming>F17</bpmn:incoming><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:intermediateThrowEvent id="LB_t" name="Continua em B"><bpmn:incoming>F24</bpmn:incoming><bpmn:linkEventDefinition id="LinkDef_LB_t" name="B"/></bpmn:intermediateThrowEvent>
<bpmn:intermediateCatchEvent id="LB_c" name="B"><bpmn:outgoing>F25</bpmn:outgoing><bpmn:linkEventDefinition id="LinkDef_LB_c" name="B"/></bpmn:intermediateCatchEvent>
<bpmn:task id="T13" name="Alterar o comportamento testado e reexecutar o teste"><bpmn:incoming>F25</bpmn:incoming><bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW5" name="O teste reprovou?"><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing><bpmn:outgoing>F29</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T14" name="Corrigir a brecha do teste"><bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing></bpmn:task>
<bpmn:task id="T15" name="Conferir as alterações e os resultados"><bpmn:incoming>F29</bpmn:incoming><bpmn:outgoing>F30</bpmn:outgoing></bpmn:task>
<bpmn:task id="T16" name="Revisar o código, os resultados e os textos gerados pela IA"><bpmn:incoming>F30</bpmn:incoming><bpmn:incoming>F33</bpmn:incoming><bpmn:outgoing>F31</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="GW6" name="Há ajustes a fazer?"><bpmn:incoming>F31</bpmn:incoming><bpmn:outgoing>F32</bpmn:outgoing><bpmn:outgoing>F34</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T17" name="Corrigir os pontos apontados"><bpmn:incoming>F32</bpmn:incoming><bpmn:outgoing>F33</bpmn:outgoing></bpmn:task>
<bpmn:task id="T18" name="Preparar issue, branch, commit e PR"><bpmn:incoming>F34</bpmn:incoming><bpmn:outgoing>F35</bpmn:outgoing></bpmn:task>
<bpmn:task id="T19" name="Aprovar os rascunhos e publicar o PR"><bpmn:incoming>F35</bpmn:incoming><bpmn:outgoing>F36</bpmn:outgoing></bpmn:task>
<bpmn:task id="T20" name="Revisar o PR (colega)"><bpmn:incoming>F36</bpmn:incoming><bpmn:outgoing>F37</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="End" name="Merge realizado"><bpmn:incoming>F37</bpmn:incoming></bpmn:endEvent>
